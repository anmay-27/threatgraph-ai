DATABASE_URL=postgresql+psycopg://threatgraph:local-development@postgres:5432/threatgraph
REDIS_URL=redis://redis:6379/0
MODEL_DIR=/app/models
STORAGE_DIR=/app/storage
PRIVACY_MODE=true
ENABLE_EXTERNAL_REPUTATION=false
PHISHTANK_API_KEY=
URLHAUS_AUTH_KEY=
MAX_UPLOAD_MB=250
RETENTION_HOURS=24
MAX_DEPTH=3
MAX_NODES=40
ALLOWED_ORIGINS=http://localhost:3000
TASK_ALWAYS_EAGER=false
DEMO_DATA=false
CLAMAV_HOST=
AUTH_REQUIRED=true
SECURE_COOKIES=false
# Account mode is enabled by default. Set SECURE_COOKIES=true behind HTTPS.

# Optional Google OAuth: Web application client. Keep secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
