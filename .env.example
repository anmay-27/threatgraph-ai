DATABASE_URL=postgresql+psycopg://threatgraph:local-development@postgres:5432/threatgraph
REDIS_URL=redis://redis:6379/0
MODEL_DIR=/app/models
STORAGE_DIR=/app/storage
PRIVACY_MODE=true
ENABLE_EXTERNAL_REPUTATION=false
PHISHTANK_API_KEY=
URLHAUS_AUTH_KEY=
MAX_UPLOAD_MB=25
RETENTION_HOURS=24
MAX_DEPTH=3
MAX_NODES=40
ALLOWED_ORIGINS=http://localhost:3000
TASK_ALWAYS_EAGER=false
DEMO_DATA=false
CLAMAV_HOST=
AUTH_REQUIRED=false
SECURE_COOKIES=false
# Enable AUTH_REQUIRED for shared hosting; enable SECURE_COOKIES behind HTTPS.
